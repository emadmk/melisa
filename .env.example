# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hatef_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl"

# Admin credentials (for initial setup)
ADMIN_EMAIL="admin@hatefertebat.ir"
ADMIN_PASSWORD="your-secure-password"

# Google Analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Site URL
NEXT_PUBLIC_SITE_URL="https://hatefertebat.ir"

# Upload settings
UPLOAD_DIR="/var/www/hatef/uploads"
MAX_FILE_SIZE="10485760"

# Backup settings
BACKUP_DIR="/var/www/hatef/backups"

# Email (optional)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
