generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Authentication ====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(ADMIN)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  EDITOR
}

// ==================== Products ====================

model Product {
  id              String            @id @default(cuid())
  titleFa         String
  titleEn         String?
  titleAr         String?           // Arabic title
  slug            String            @unique
  shortDesc       String?           @db.Text
  shortDescAr     String?           @db.Text  // Arabic short description
  fullDesc        String?           @db.Text
  fullDescAr      String?           @db.Text  // Arabic full description
  image           String?
  gallery         String[]
  catalogFile     String?
  status          ContentStatus     @default(DRAFT)
  featured        Boolean           @default(false)
  metaTitle       String?
  metaTitleAr     String?           // Arabic meta title
  metaDesc        String?
  metaDescAr      String?           // Arabic meta description
  focusKeyword    String?
  keywords        String[]
  categoryId      String?
  category        Category?         @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?            @relation(fields: [brandId], references: [id])
  attributes      ProductAttribute[]
  inquiries       Inquiry[]
  viewCount       Int               @default(0)
  oldUrl          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([slug])
}

model ProductAttribute {
  id        String  @id @default(cuid())
  key       String
  keyAr     String? // Arabic key
  value     String
  valueAr   String? // Arabic value
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Int     @default(0)

  @@index([productId])
}

// ==================== Categories ====================

model Category {
  id            String     @id @default(cuid())
  nameFa        String
  nameEn        String?
  nameAr        String?    // Arabic name
  slug          String     @unique
  description   String?    @db.Text
  descriptionAr String?    @db.Text  // Arabic description
  image         String?
  parentId      String?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryHierarchy")
  products      Product[]
  order         Int        @default(0)
  metaTitle     String?
  metaTitleAr   String?    // Arabic meta title
  metaDesc      String?
  metaDescAr    String?    // Arabic meta description
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([parentId])
  @@index([slug])
}

// ==================== Brands ====================

model Brand {
  id            String    @id @default(cuid())
  name          String
  nameAr        String?   // Arabic name
  slug          String    @unique
  logo          String?
  description   String?   @db.Text
  descriptionAr String?   @db.Text  // Arabic description
  website       String?
  products      Product[]
  featured      Boolean   @default(false)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([slug])
}

// ==================== Services ====================

model Service {
  id              String        @id @default(cuid())
  titleFa         String
  titleEn         String?
  titleAr         String?       // Arabic title
  slug            String        @unique
  shortDesc       String?       @db.Text
  shortDescAr     String?       @db.Text  // Arabic short description
  fullDesc        String?       @db.Text
  fullDescAr      String?       @db.Text  // Arabic full description
  icon            String?
  image           String?
  status          ContentStatus @default(DRAFT)
  order           Int           @default(0)
  metaTitle       String?
  metaTitleAr     String?       // Arabic meta title
  metaDesc        String?
  metaDescAr      String?       // Arabic meta description
  focusKeyword    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slug])
}

// ==================== Blog ====================

model Post {
  id              String        @id @default(cuid())
  titleFa         String
  titleEn         String?
  titleAr         String?       // Arabic title
  slug            String        @unique
  excerpt         String?       @db.Text
  excerptAr       String?       @db.Text  // Arabic excerpt
  content         String?       @db.Text
  contentAr       String?       @db.Text  // Arabic content
  image           String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  author          String?
  postCategoryId  String?
  postCategory    PostCategory? @relation(fields: [postCategoryId], references: [id])
  tags            String[]
  viewCount       Int           @default(0)
  metaTitle       String?
  metaTitleAr     String?       // Arabic meta title
  metaDesc        String?
  metaDescAr      String?       // Arabic meta description
  focusKeyword    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([postCategoryId])
  @@index([status])
  @@index([slug])
}

model PostCategory {
  id        String   @id @default(cuid())
  nameFa    String
  nameEn    String?
  nameAr    String?  // Arabic name
  slug      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// ==================== Projects ====================

model Project {
  id              String        @id @default(cuid())
  titleFa         String
  titleEn         String?
  titleAr         String?       // Arabic title
  slug            String        @unique
  description     String?       @db.Text
  descriptionAr   String?       @db.Text  // Arabic description
  images          String[]
  client          String?
  clientAr        String?       // Arabic client name
  location        String?
  locationAr      String?       // Arabic location
  year            String?
  status          ContentStatus @default(DRAFT)
  featured        Boolean       @default(false)
  order           Int           @default(0)
  metaTitle       String?
  metaTitleAr     String?       // Arabic meta title
  metaDesc        String?
  metaDescAr      String?       // Arabic meta description
  focusKeyword    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([slug])
}

// ==================== Certificates ====================

model Certificate {
  id            String        @id @default(cuid())
  titleFa       String
  titleEn       String?
  titleAr       String?       // Arabic title
  slug          String        @unique
  description   String?       @db.Text
  descriptionAr String?       @db.Text  // Arabic description
  image         String?
  issuer        String?
  issuerAr      String?       // Arabic issuer
  issueDate     DateTime?
  status        ContentStatus @default(DRAFT)
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([slug])
}

// ==================== Catalogs ====================

model Catalog {
  id            String        @id @default(cuid())
  titleFa       String
  titleEn       String?
  titleAr       String?       // Arabic title
  slug          String        @unique
  description   String?       @db.Text
  descriptionAr String?       @db.Text  // Arabic description
  file          String
  thumbnail     String?
  categoryId    String?
  category      CatalogCategory? @relation(fields: [categoryId], references: [id])
  downloads     Int           @default(0)
  status        ContentStatus @default(DRAFT)
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([categoryId])
  @@index([slug])
}

model CatalogCategory {
  id        String    @id @default(cuid())
  nameFa    String
  nameEn    String?
  nameAr    String?   // Arabic name
  slug      String    @unique
  catalogs  Catalog[]
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
}

// ==================== FAQ ====================

model Faq {
  id         String        @id @default(cuid())
  question   String
  questionAr String?       // Arabic question
  answer     String        @db.Text
  answerAr   String?       @db.Text  // Arabic answer
  categoryId String?
  category   FaqCategory?  @relation(fields: [categoryId], references: [id])
  status     ContentStatus @default(DRAFT)
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([categoryId])
}

model FaqCategory {
  id        String   @id @default(cuid())
  nameFa    String
  nameEn    String?
  nameAr    String?  // Arabic name
  slug      String   @unique
  faqs      Faq[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// ==================== Inquiries ====================

model Inquiry {
  id          String        @id @default(cuid())
  name        String
  company     String?
  phone       String
  email       String
  message     String?       @db.Text
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id])
  status      InquiryStatus @default(NEW)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([productId])
  @@index([status])
}

enum InquiryStatus {
  NEW
  REVIEWED
  ANSWERED
  CLOSED
}

// ==================== Contact Messages ====================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== Settings ====================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ==================== Backups ====================

model Backup {
  id        String   @id @default(cuid())
  filename  String
  size      Int
  type      String
  createdAt DateTime @default(now())
}

// ==================== Enums ====================

enum ContentStatus {
  DRAFT
  PUBLISHED
}
